<Window x:Class="SolarSystem3D.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:vm="clr-namespace:SolarSystem3D.App.ViewModels"
        Title="Solar System 3D" Width="1500" Height="920" MinWidth="1000" MinHeight="640"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <vm:Log10Converter x:Key="Log10"/>
        <vm:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
        <vm:ColorToBrushConverter x:Key="ColorToBrush"/>
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Command" Value="{Binding StepCommand}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===================== Calendar & clock bar ===================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left" Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClockText}" FontSize="20" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding JulianDateText}" Style="{StaticResource Muted}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Date" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="120" VerticalAlignment="Center"
                                DisplayDateStart="1000-01-01" DisplayDateEnd="3000-12-31" GotKeyboardFocus="OnEditTimeFocus"/>
                    <TextBlock Text="Time" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox x:Name="TimeBox" Text="{Binding TimeText, UpdateSourceTrigger=LostFocus}" Width="70"
                             FontFamily="Consolas" VerticalAlignment="Center" KeyDown="OnTimeBoxKeyDown"
                             GotKeyboardFocus="OnEditTimeFocus" ToolTip="hh:mm or hh:mm:ss, press Enter to apply"/>
                    <CheckBox Content="Local time" IsChecked="{Binding UseLocalTime}" VerticalAlignment="Center" Margin="10,0"/>
                    <Button Content="Now" Command="{Binding NowCommand}" FontWeight="SemiBold" Margin="6,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource StepButton}" Content="−1y" CommandParameter="-1y" ToolTip="Back one year"/>
                    <Button Style="{StaticResource StepButton}" Content="−1mo" CommandParameter="-1mo" ToolTip="Back one month"/>
                    <Button Style="{StaticResource StepButton}" Content="−1d" CommandParameter="-1d" ToolTip="Back one day"/>
                    <Button Style="{StaticResource StepButton}" Content="−1h" CommandParameter="-1h" ToolTip="Back one hour"/>
                    <Button Content="◀◀" Command="{Binding PlayBackwardCommand}" ToolTip="Run backwards" Margin="8,2,2,2"/>
                    <Button Content="{Binding PlayGlyph}" Command="{Binding TogglePlayCommand}" MinWidth="40" FontSize="14"
                            ToolTip="Play / pause (Space)"/>
                    <Button Content="▶▶" Command="{Binding PlayForwardCommand}" ToolTip="Run forwards" Margin="2,2,8,2"/>
                    <Button Style="{StaticResource StepButton}" Content="+1h" CommandParameter="+1h" ToolTip="Forward one hour"/>
                    <Button Style="{StaticResource StepButton}" Content="+1d" CommandParameter="+1d" ToolTip="Forward one day"/>
                    <Button Style="{StaticResource StepButton}" Content="+1mo" CommandParameter="+1mo" ToolTip="Forward one month"/>
                    <Button Style="{StaticResource StepButton}" Content="+1y" CommandParameter="+1y" ToolTip="Forward one year"/>
                    <TextBlock Text="Speed" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Rates}" SelectedItem="{Binding Clock.Rate}" Width="130" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0" Padding="10,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding FrameRateText}" Style="{StaticResource Muted}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DateWarning}" Foreground="#FFB060" Margin="0,0,16,0"
                           Visibility="{Binding DateWarning, Converter={StaticResource EmptyToCollapsed}}"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}"/>
            </DockPanel>
        </Border>

        <!-- ===================== Left: search & display options ===================== -->
        <Border DockPanel.Dock="Left" Width="290" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,4,10,10">
                <StackPanel>
                    <TextBlock Text="Find an object" Style="{StaticResource SectionTitle}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Type part of a name: planet, moon, asteroid, comet (e.g. Titan, Vesta, Halley)"/>
                    <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}"
                             MaxHeight="150" Margin="0,4,0,0" MouseDoubleClick="OnSearchDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding Kind, StringFormat='  ({0})'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Go to" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel>
                        <Button Content="Sun" Command="{Binding GoToCommand}" CommandParameter="Sun"/>
                        <Button Content="Mercury" Command="{Binding GoToCommand}" CommandParameter="Mercury"/>
                        <Button Content="Venus" Command="{Binding GoToCommand}" CommandParameter="Venus"/>
                        <Button Content="Earth" Command="{Binding GoToCommand}" CommandParameter="Earth"/>
                        <Button Content="Mars" Command="{Binding GoToCommand}" CommandParameter="Mars"/>
                        <Button Content="Jupiter" Command="{Binding GoToCommand}" CommandParameter="Jupiter"/>
                        <Button Content="Saturn" Command="{Binding GoToCommand}" CommandParameter="Saturn"/>
                        <Button Content="Uranus" Command="{Binding GoToCommand}" CommandParameter="Uranus"/>
                        <Button Content="Neptune" Command="{Binding GoToCommand}" CommandParameter="Neptune"/>
                        <Button Content="Pluto" Command="{Binding GoToCommand}" CommandParameter="Pluto"/>
                        <Button Content="Ceres" Command="{Binding GoToCommand}" CommandParameter="Ceres"/>
                        <Button Content="Eris" Command="{Binding GoToCommand}" CommandParameter="Eris"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="Overview" Command="{Binding ResetViewCommand}" ToolTip="Back to the whole solar system (Home)"/>
                        <Button Content="Centre on selected" Command="{Binding CenterOnSelectedCommand}" ToolTip="F"/>
                    </WrapPanel>

                    <Expander Header="Objects" IsExpanded="True">
                        <StackPanel>
                            <CheckBox Content="Dwarf planets" IsChecked="{Binding Display.ShowDwarfPlanets}"/>
                            <CheckBox Content="Moons" IsChecked="{Binding Display.ShowMoons}"/>
                            <CheckBox Content="Asteroids" IsChecked="{Binding Display.ShowAsteroids}"/>
                            <CheckBox Content="Comets" IsChecked="{Binding Display.ShowComets}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Orbits" IsExpanded="True">
                        <StackPanel>
                            <CheckBox Content="Planets" IsChecked="{Binding Display.ShowPlanetOrbits}"/>
                            <CheckBox Content="Dwarf planets" IsChecked="{Binding Display.ShowDwarfPlanetOrbits}"/>
                            <CheckBox Content="Moons (when zoomed in)" IsChecked="{Binding Display.ShowMoonOrbits}"/>
                            <CheckBox Content="Irregular (outer) moons" IsChecked="{Binding Display.ShowIrregularMoonOrbits}" Margin="20,3,0,3"
                                      IsEnabled="{Binding Display.ShowMoonOrbits}"
                                      ToolTip="Distant captured moons — Jupiter, Saturn, Uranus and Neptune have hundreds"/>
                            <CheckBox Content="Comets within a year of perihelion" IsChecked="{Binding Display.ShowCometOrbits}"/>
                            <CheckBox Content="All numbered periodic comets" IsChecked="{Binding Display.ShowPeriodicCometOrbits}"/>
                            <CheckBox Content="Asteroids (brightest)" IsChecked="{Binding Display.ShowAsteroidOrbits}"/>
                            <DockPanel Margin="20,0,0,0" IsEnabled="{Binding Display.ShowAsteroidOrbits}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Display.AsteroidOrbitCount}" Width="34" TextAlignment="Right"/>
                                <Slider Minimum="10" Maximum="1000" Value="{Binding Display.AsteroidOrbitCount, Delay=250}"
                                        IsSnapToTickEnabled="True" TickFrequency="10"/>
                            </DockPanel>
                            <CheckBox Content="Selected object" IsChecked="{Binding Display.ShowSelectedOrbit}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Names" IsExpanded="True">
                        <StackPanel>
                            <CheckBox Content="Sun and planets" IsChecked="{Binding Display.LabelPlanets}"/>
                            <CheckBox Content="Dwarf planets" IsChecked="{Binding Display.LabelDwarfPlanets}"/>
                            <CheckBox Content="Moons (when zoomed in)" IsChecked="{Binding Display.LabelMoons}"/>
                            <CheckBox Content="Irregular (outer) moons" IsChecked="{Binding Display.LabelIrregularMoons}" Margin="20,3,0,3"
                                      IsEnabled="{Binding Display.LabelMoons}"/>
                            <CheckBox Content="Asteroids (brightest in view)" IsChecked="{Binding Display.LabelAsteroids}"/>
                            <CheckBox Content="Comets (closest to the Sun)" IsChecked="{Binding Display.LabelComets}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Scene" IsExpanded="True">
                        <StackPanel>
                            <CheckBox Content="Ecliptic grid (AU rings)" IsChecked="{Binding Display.ShowEclipticGrid}"/>
                            <TextBlock Margin="0,6,0,0">
                                <Run Text="Body size ×"/><Run Text="{Binding Display.BodyScale, StringFormat={}{0:0}, Mode=OneWay}"/>
                            </TextBlock>
                            <Slider Minimum="0" Maximum="3" SmallChange="0.05" LargeChange="0.5"
                                    Value="{Binding Display.BodyScale, Converter={StaticResource Log10}}"
                                    ToolTip="Exaggerate planet and moon sizes (1 = true scale). The Sun is capped at ×10."/>
                            <TextBlock Margin="0,6,0,0">
                                <Run Text="Marker size ×"/><Run Text="{Binding Display.MarkerSize, StringFormat={}{0:0.0}, Mode=OneWay}"/>
                            </TextBlock>
                            <Slider Minimum="0.5" Maximum="3" SmallChange="0.1" Value="{Binding Display.MarkerSize}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Asteroid colours" IsExpanded="False">
                        <ItemsControl ItemsSource="{Binding Legend}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Ellipse Width="9" Height="9" Fill="{Binding Color, Converter={StaticResource ColorToBrush}}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <Expander Header="Catalogs" IsExpanded="False">
                        <StackPanel>
                            <TextBlock Text="{Binding CatalogStatus}" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding AsteroidCatalogOptions}" SelectedItem="{Binding SelectedCatalogOption}"
                                      SelectedIndex="0"/>
                            <Button Content="Download latest from NASA/JPL" Command="{Binding DownloadCatalogsCommand}" Margin="0,6,0,2"
                                    ToolTip="Fetches current asteroid and comet orbital elements from the JPL Small-Body Database"/>
                            <Button Content="Use built-in snapshot" Command="{Binding UseBuiltInCatalogsCommand}" Margin="0,2"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="Planets: JPL approximate elements. Moon: ELP-2000/82 (Meeus). Moons: JPL mean elements calibrated to JPL Horizons. Asteroids, dwarf planets and comets: JPL Small-Body Database."/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== Right: selected object ===================== -->
        <Border DockPanel.Dock="Right" Width="320" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,4,12,12">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedType}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,8"/>
                    <WrapPanel>
                        <Button Content="Centre on it" Command="{Binding CenterOnSelectedCommand}"/>
                        <Button Content="Centre on Sun" Command="{Binding CenterOnSunCommand}"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding InfoRows}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Controls" Style="{StaticResource SectionTitle}" Margin="0,18,0,4"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" xml:space="preserve">Left-drag: rotate      Right-drag: pan
Mouse wheel: zoom        Click: select
Double-click: centre and zoom on an object
Space: play/pause   Home: overview   F: centre on selected</TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== 3D view ===================== -->
        <Grid>
            <h:HelixViewport3D x:Name="Viewport" Background="#04060E" ClipToBounds="True"
                               CameraRotationMode="Turntable" ModelUpDirection="0,0,1"
                               RotateGesture="LeftClick" PanGesture="RightClick"
                               IsHeadLightEnabled="False" ShowCoordinateSystem="False" ShowViewCube="True"
                               ViewCubeOpacity="0.6" ViewCubeWidth="70" ViewCubeHeight="70"
                               ZoomAroundMouseDownPoint="False" RotateAroundMouseDownPoint="False"
                               IsInertiaEnabled="True" InfiniteSpin="False"
                               ViewCubeFrontText="+Y" ViewCubeBackText="−Y" ViewCubeLeftText="−X" ViewCubeRightText="+X"
                               ViewCubeTopText="N" ViewCubeBottomText="S">
                <h:HelixViewport3D.Camera>
                    <PerspectiveCamera Position="0,-11,7.5" LookDirection="0,11,-7.5" UpDirection="0,0,1"
                                       FieldOfView="45" NearPlaneDistance="0.001"/>
                </h:HelixViewport3D.Camera>
            </h:HelixViewport3D>
            <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True"/>
            <TextBlock Text="Loading catalogs…" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" x:Name="LoadingText"/>
        </Grid>
    </DockPanel>
</Window>
