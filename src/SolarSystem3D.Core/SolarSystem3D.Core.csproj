<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SolarSystem3D.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared astronomy core (git submodule): vectors, time scales, frames, planet/Moon/Earth models. -->
    <ProjectReference Include="..\..\external\AstroCore\src\AstroCore\AstroCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Offline snapshots of the JPL catalogs (refreshable at runtime via CatalogDownloader). -->
    <EmbeddedResource Include="Data\Embedded\*.tsv" />
  </ItemGroup>

</Project>
